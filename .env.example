# Port exposed by docker compose on the host
PORT=8088
# SQLite database, uploads and Typst font cache
DATA_DIR=./data

# Public URL of the blog. Needed when it is NOT served over HTTPS (e.g. http://raspberrypi.local:8088),
# otherwise the session cookie is marked Secure and logging in fails over plain HTTP.
# ORIGIN=https://blog.example.com

# Initial values only: afterwards they are edited in Admin > Paramètres
ALLOW_REGISTRATION=false
SITE_TITLE=Typst Blog
SITE_DESCRIPTION=Moteur de blog moderne propulsé par Typst et SvelteKit

# Maximum request body size (uploads are limited to 25 Mo)
BODY_SIZE_LIMIT=26M
